rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function ownUserExists() {
      return isSignedIn() && exists(ownUserPath());
    }

    function ownRole() {
      return ownUserExists() ? get(ownUserPath()).data.role : '';
    }

    function hasAppRole() {
      return ownRole() in ['admin', 'employee'];
    }

    function isAdmin() {
      return ownRole() == 'admin';
    }

    // Lead teams: employees in a lead's `teamMembers` work on it alongside
    // the owner (`assignedTo`). Owner/admin manage the team; a member may
    // only remove themself.
    function isOnLeadTeam(data) {
      return request.auth.uid in data.teamMembers;
    }

    function canWorkOnLead(leadId) {
      let lead = get(/databases/$(database)/documents/leads/$(leadId)).data;
      return lead.assignedTo == request.auth.uid
        || request.auth.uid in lead.get('teamMembers', []);
    }

    // Product catalog editors: admins, explicit flag, or named editors
    // (Pratima / Pooja — requested full catalog CRUD).
    function canManageCatalog() {
      return isAdmin()
        || (ownUserExists()
            && get(ownUserPath()).data.keys().hasAny(['canManageCatalog'])
            && get(ownUserPath()).data.canManageCatalog == true)
        || (ownUserExists()
            && get(ownUserPath()).data.keys().hasAny(['name'])
            && get(ownUserPath()).data.name is string
            && get(ownUserPath()).data.name.matches('(?i).*(pratima|pooja).*'));
    }

    // Profiles — own doc must be readable immediately after sign-in (for role routing).
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && hasAppRole();
      allow read: if isSignedIn() && (request.auth.uid == userId || hasAppRole());

      allow create: if isAdmin();
      allow delete: if isAdmin();

      // `fcmToken` is the device push token, written by PushNotificationService
      // after sign-in and deleted on sign-out. Still self-only and still
      // key-restricted — no other profile field becomes writable.
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastActive', 'isOnline', 'fcmToken']);

      allow update: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isSignedIn() && hasAppRole()
        && (isAdmin()
            || resource.data.assignedTo == request.auth.uid
            || isOnLeadTeam(resource.data));

      allow create: if isSignedIn() && hasAppRole()
        && (isAdmin() || request.resource.data.assignedTo == request.auth.uid);

      allow update: if isSignedIn() && hasAppRole()
        && (isAdmin()
            || resource.data.assignedTo == request.auth.uid
            // Team member: work on the lead, but not move it or edit the team…
            || (isOnLeadTeam(resource.data)
                && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['assignedTo', 'teamMembers']))
            // …except to leave it.
            || (isOnLeadTeam(resource.data)
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['teamMembers', 'lastModified'])
                && request.resource.data.teamMembers.toSet()
                    == resource.data.teamMembers.toSet()
                        .difference([request.auth.uid].toSet())));

      allow delete: if isSignedIn() && hasAppRole()
        && (isAdmin() || resource.data.assignedTo == request.auth.uid);

      match /events/{eventId} {
        allow read, write: if isSignedIn() && hasAppRole()
          && (isAdmin() || canWorkOnLead(leadId));
      }

      match /smart_follow_ups/{followUpId} {
        allow read, write: if isSignedIn() && hasAppRole()
          && (isAdmin() || canWorkOnLead(leadId));
      }
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && hasAppRole()
        && (isAdmin() || resource.data.assignedTo == request.auth.uid || resource.data.assignedBy == request.auth.uid);

      allow create: if isSignedIn() && hasAppRole()
        && (isAdmin() || request.resource.data.assignedBy == request.auth.uid);

      allow update, delete: if isSignedIn() && hasAppRole()
        && (isAdmin() || resource.data.assignedBy == request.auth.uid || resource.data.assignedTo == request.auth.uid);
    }

    match /products/{productId} {
      allow read: if isSignedIn() && hasAppRole();
      allow write: if isSignedIn() && hasAppRole() && canManageCatalog();
    }

    match /settings/{docId} {
      allow read: if isSignedIn() && hasAppRole();
      allow create: if isSignedIn() && hasAppRole();
      allow update, delete: if isAdmin();
    }

    match /quotations/{quotationId} {
      // Team members can also see each other's quotations on a shared lead.
      allow read: if isSignedIn() && hasAppRole()
        && (isAdmin()
            || resource.data.employeeId == request.auth.uid
            || canWorkOnLead(resource.data.leadId));

      allow create: if isSignedIn() && hasAppRole()
        && (isAdmin() || request.resource.data.employeeId == request.auth.uid);

      allow update, delete: if isSignedIn() && hasAppRole()
        && (isAdmin() || resource.data.employeeId == request.auth.uid);
    }

    // Collection-group reads for manager dashboard recent activity (admin only).
    match /{path=**}/events/{eventId} {
      allow read: if isSignedIn() && hasAppRole() && isAdmin();
    }
  }
}
